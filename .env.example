# Firebase / Google accounts — OPTIONAL.
# Copy this file to ".env.local" and fill in the values from your Firebase project.
# If these are left unset, the app runs exactly as before: local-only, no sign-in.
#
# These are Firebase *web* config values. They are NOT secrets — they are meant to
# ship to the client. Access to your notes is controlled by Firestore security
# rules, not by hiding these keys. The owner-only rules live in firestore.rules at
# the repo root; deploy them from source with:  firebase deploy --only firestore:rules
#
# Where to find them:
#   Firebase console -> Project settings -> General -> "Your apps" -> Web app -> SDK config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional (only needed if you later use Storage / Messaging):
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# Desktop (Tauri) sign-in only. The browser build (npm run dev) does NOT need these
# — it uses Firebase's popup flow. The desktop app can't use popups, so it runs a
# system-browser loopback OAuth flow instead, which needs a Google "Desktop app"
# OAuth client (APIs & Services -> Credentials -> Create credentials -> OAuth client
# ID -> Application type: Desktop app). Copy its client id AND secret here. The
# secret is embedded in the desktop app and is NOT treated as confidential in this
# flow (per Google's native-app guidance).
VITE_GOOGLE_DESKTOP_CLIENT_ID=
VITE_GOOGLE_DESKTOP_CLIENT_SECRET=
