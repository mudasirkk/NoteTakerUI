rules_version = '2';

// NoteTakerUI cloud sync. Every map lives under users/<uid>/maps/<id>, so the
// owner is encoded in the path. A signed-in user may read and write only their
// own subtree; everything else is denied by default (no rule grants it).
service cloud.firestore {
  match /databases/{database}/documents {

    // A user's own maps — the only data the app stores.
    match /users/{uid}/maps/{mapId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Explicit catch-all deny. Firestore already denies unmatched paths, but
    // stating it makes the intent reviewable and stops a future "test mode"
    // toggle from silently opening the database.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
